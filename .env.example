# Keel — copy to .env and fill in. NEVER commit .env.
# Use throwaway keys only. These wallets hold testnet funds with no monetary value.

# Shannon testnet
RPC_URL=https://dream-rpc.somnia.network
CHAIN_ID=50312

# Two separate throwaway keys. 0x-prefixed, 64 hex chars.
# Deployer owns the vault + factory. Bot signs quotes.
DEPLOYER_PRIVATE_KEY=
BOT_PRIVATE_KEY=

# DreamDEX venue (verified live 2026-09-01)
VENUE_ID=0x679795a0195a1b76cdebb7c51d74e058aee92919b8c3389af86ef24535e8a28c

# Read-only services (no key needed)
INDEXER_URL=https://dev.smk.somnia.host/v1/graphql
PRICEFEED_URL=https://price-feed.dev.oracle.somnia.host/v1/graphql

# Quoter safety rails
DRY_RUN=true
MAX_NOTIONAL_PER_WINDOW=25
MIN_SPREAD_BPS=150
